#!/usr/bin/env ruby

ENV["RAILS_ENV"] ||= ENV["RACK_ENV"] || "development"
ENV["NODE_ENV"]  ||= "development"
ENV["NODE_OPTIONS"] = [ENV.fetch("NODE_OPTIONS", nil), "--openssl-legacy-provider"].compact.join(" ").strip unless ENV["NODE_OPTIONS"].to_s.include?("--openssl-legacy-provider")

require "pathname"
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../../Gemfile",
  Pathname.new(__FILE__).realpath)

require "bundler/setup"

def patch_webpacker_yaml_loader!
  root = File.expand_path("..", __dir__)
  files = [
    File.join(root, "node_modules/@rails/webpacker/package/env.js"),
    File.join(root, "node_modules/@rails/webpacker/package/config.js")
  ]

  files.each do |file|
    next unless File.exist?(file)

    content = File.read(file)
    next unless content.include?("safeLoad")

    updated = content.gsub("safeLoad", "load")
    File.write(file, updated)
  end
end

patch_webpacker_yaml_loader!

require "webpacker"
require "webpacker/webpack_runner"

APP_ROOT = File.expand_path("..", __dir__)
Dir.chdir(APP_ROOT) do
  Webpacker::WebpackRunner.run(ARGV)
end
